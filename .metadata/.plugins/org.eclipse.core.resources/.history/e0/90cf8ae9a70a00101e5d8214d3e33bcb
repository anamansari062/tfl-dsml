    def generateJavaCode(TflSystem model) '''
        import java.util.*;

        public class TransportScheduler {

            private Map<String, Integer> capacities = new HashMap<>();  // Transport -> Capacity
            private Map<String, Integer> speeds = new HashMap<>();  // Transport -> Speed
            private Map<String, List<Pair<String, Integer>>> routes = new HashMap<>();  // Transport -> Route
            private Map<String, Pair<Integer, Integer>> passengers = new HashMap<>();  // Transport -> (Peak, Non-peak)
            private Map<String, Pair<String, Integer>> disruptions = new HashMap<>();  // Disruption Name -> (Stop, Duration)

            public void addTransport(String name, int capacity, int speed, List<Pair<String, Integer>> route, int peak, int nonPeak) {
                capacities.put(name, capacity);
                speeds.put(name, speed);
                routes.put(name, route);
                passengers.put(name, new Pair<>(peak, nonPeak));
            }

            public void addDisruption(String disruptionName, String stop, int duration) {
                disruptions.put(disruptionName, new Pair<>(stop, duration));
            }

            public void generateSchedule() {
                System.out.println("===== Transport Schedules =====");
                for (Map.Entry<String, List<Pair<String, Integer>>> entry : routes.entrySet()) {
                    String transport = entry.getKey();
                    List<Pair<String, Integer>> routeList = entry.getValue();
                    System.out.println("\nSchedule for " + transport + ":");
                    int time = 0;
                    for (Pair<String, Integer> stop : routeList) {
                        time += stop.getValue();
                        if (isDisrupted(transport, stop.getKey())) {
                            System.out.println("  " + stop.getKey() + " - Delayed by " + disruptions.get(transport).getValue() + " min");
                            time += disruptions.get(transport).getValue();
                        }
                        System.out.println("  " + stop.getKey() + " - Arrival: " + time + " min");
                    }
                }
            }

            private boolean isDisrupted(String transport, String stop) {
                return disruptions.containsKey(transport) && disruptions.get(transport).getKey().equals(stop);
            }

            public void calculateFare() {
                System.out.println("\n===== Fare Calculation =====");
                for (Map.Entry<String, Pair<Integer, Integer>> entry : passengers.entrySet()) {
                    String transport = entry.getKey();
                    Pair<Integer, Integer> pax = entry.getValue();
                    int capacity = capacities.get(transport);
                    double peakFare = calculateFareForDemand(capacity, pax.getKey());
                    double nonPeakFare = calculateFareForDemand(capacity, pax.getValue());
                    System.out.println("\nTransport: " + transport);
                    System.out.println("  Peak Fare: £" + peakFare);
                    System.out.println("  Non-Peak Fare: £" + nonPeakFare);
                }
            }

            private double calculateFareForDemand(int capacity, int demand) {
                double baseFare = 5.0;
                double demandFactor = (demand > capacity * 0.8) ? 1.5 : (demand < capacity * 0.5) ? 0.8 : 1.0;
                return baseFare * demandFactor;
            }

