class TflValidator extends AbstractTflValidator {
	
	public static final String INVALID_STOP_NAME = "invalidStopName";
	public static final String UNUSED_STOP = "unusedStop";
	public static final String DUPLICATE_DISRUPTION = "duplicateDisruption";
	
	@Check
	def checkStopName(Stop stop){
		if (Character.isLowerCase(stop.name.charAt(0))) {
			warning('Stop name should start with an upper-case character', stop,
				TflPackage.Literals.STOP__NAME, INVALID_STOP_NAME)
		}
	}
	
	@Check(NORMAL)
	def checkIfStopIsUsed(TflSystem system) {
    	for (stop : system.stops) {
        	if (!isStopReferenced(stop, system.transports, system.disruptions)) {
            	warning("This stop '" + stop.name + "' is unused", stop,
                	TflPackage.Literals.STOP__NAME, UNUSED_STOP)
        	}
    	}
	}

	def boolean isStopReferenced(Stop stop, EList<Transport> transports, EList<Disruption> disruptions) {
    	for (transport : transports) {
        	for (route : transport.routes) {
            	if (route.start.equals(stop.name) || route.end.equals(stop.name)) {
                	return true // Stop is used in a transport route
            	}
        	}
    	}
    
    	for (disruption : disruptions) {
        	if (disruption.stop == stop) {
            	return true // Stop is affected by a disruption
        	}
    	}
    
    	return false // Stop is unused
	}


