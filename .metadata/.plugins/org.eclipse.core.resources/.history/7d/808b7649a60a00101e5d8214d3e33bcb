 */
class TflGenerator extends AbstractGenerator {	
	
    override void doGenerate(Resource resource, IFileSystemAccess2 fsa, IGeneratorContext context) {
        val model = resource.allContents.filter(typeof(Model)).head
        if (model !== null) {
            fsa.generateFile("schedule.txt", generateSchedule(model))
        }
    }

    def generateSchedule(Model model) '''
        === TRANSPORT SCHEDULE ===

        «FOR transport : model.transports»
        Transport: «transport.name»
        Capacity: «transport.capacity»
        Speed: «transport.speed» km/h
        Peak passengers: «transport.peak»
        Non-peak passengers: «transport.nonPeak»
        Routes:
        «FOR route : transport.routes»
          - «route.start» → «route.end» (Time: «route.duration» min)
        «ENDFOR»
        
        Suggested Fare: £«calculateFare(transport)»
        -------------------------
        «ENDFOR»

        === DISRUPTIONS ===
        «FOR disruption : model.disruptions»
        - Disruption «disruption.name» affects «disruption.transport.name» at «disruption.stop.name»
          Duration: «disruption.duration» min
        «ENDFOR»
    '''

    def calculateFare(Transport transport) {
        val baseFare = 2.0 // Base fare per trip
        val avgRouteTime = transport.routes.map[r | r.duration].reduce[a, b | a + b] / transport.routes.size
        return Math.round(baseFare + (avgRouteTime / 10.0) * transport.speed)
    }
}
