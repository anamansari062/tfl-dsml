package org.xtext.example.tfl.ui.quickfix;

import org.eclipse.xtext.ui.editor.quickfix.DefaultQuickfixProvider;
import org.eclipse.xtext.ui.editor.quickfix.Fix
import org.xtext.example.tfl.validation.TflValidator
import org.eclipse.xtext.validation.Issue
import org.eclipse.xtext.ui.editor.quickfix.IssueResolutionAcceptor

/**
 * Custom quickfixes.
 *
 * See https://www.eclipse.org/Xtext/documentation/310_eclipse_support.html#quick-fixes
 */
class TflQuickfixProvider extends DefaultQuickfixProvider {

	@Fix(TflValidator.INVALID_STOP_NAME)
	def capitalizeName(Issue issue, IssueResolutionAcceptor acceptor) {
		acceptor.accept(issue, 'Capitalise stop name', 'Capitalise the stop name.', 'upcase.png') [
			context |
			val xtextDocument = context.xtextDocument
			val firstLetter = xtextDocument.get(issue.offset, 1)
			xtextDocument.replace(issue.offset, 1, firstLetter.toUpperCase)
		]
	}
	
@Fix(TflValidator.UNUSED_STOP)
def removeUnusedStop(Issue issue, IssueResolutionAcceptor acceptor) {
    acceptor.accept(issue, "Remove this stop", "Removes the unused stop from the model", "") [
        context |
        val xtextDocument = context.xtextDocument
        
        // Get the position of the unused stop
        val offset = issue.offset
        val length = issue.length
        
        // Remove the stop declaration from the document
        xtextDocument.replace(offset, length, "")
    ]
}

