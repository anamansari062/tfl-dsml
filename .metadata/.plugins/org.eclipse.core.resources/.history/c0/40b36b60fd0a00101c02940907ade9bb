grammar org.xtext.example.tfl.Tfl with org.eclipse.xtext.common.Terminals

generate tfl "http://www.xtext.org/example/tfl/Tfl"

import "http://www.eclipse.org/emf/2002/Ecore" as ecore

TflSystem:
    stops+=Stop*
    transports+=Transport*
    disruptions+=Disruption*;
    
Stop:
    'stop' name=ID;

Transport:
    'transport' name=ID 
    'capacity' capacity=INT 
    'speed' speed=REAL 'kmph' 
    'routes' '{' routes+=Route* '}' 
    'passengers' '{' 
        'peak' peak=INT 
        'nonpeak' nonPeak=INT 
    '}';

Route:
    start=ID '->' end=ID 'in' duration=INT 'min';

Disruption:
    'disruption' name=ID 
    'affects' transport=[Transport] 
    'at' stop=[Stop] 
    'duration' duration=INT 'min';

REAL returns ecore::EFloat hidden():
	INT? "." INT
;
